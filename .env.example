# ── Inversión Helper ─────────────────────────────────────────────────────────
# Copia este archivo a .env y completa los valores

# Broker API
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Base de datos (opcional — por defecto usa SQLite)
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256

# Modo paper trading (default: true)
PAPER_TRADING=true

# Polygon (opcional — fallback si yfinance falla)
POLYGON_API_KEY=
