# ── Inversion Helper ─────────────────────────────────────────────────────────
# Copia este archivo a .env y completa los valores

# Broker API
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# Base de datos (opcional — por defecto usa SQLite)
DATABASE_URL=

# JWT (genera con: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=
JWT_ALGORITHM=HS256

# Polygon (opcional — fallback si yfinance falla)
POLYGON_API_KEY=

# Notificaciones (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Entorno: development | production
ENV=development
