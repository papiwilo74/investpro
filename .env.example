# ══════════════════════════════════════════════════════════════════════
#  INVERSION HELPER — Configuración por Variables de Entorno
# ══════════════════════════════════════════════════════════════════════

# ── Ambiente ────────────────────────────────────────────────────────────
# Valores: development, staging, production
ENV=development

# ── Alpaca Broker (obligatorio para trading) ────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# ── Telegram (opcional, alertas críticas del bot) ───────────────────────
# Crea un bot con @BotFather y obtén tu chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord (opcional, alternativa a Telegram) ──────────────────────────
DISCORD_WEBHOOK_URL=

# ── Data Provider ───────────────────────────────────────────────────────
# Fuente de datos: yfinance (gratuito), alpaca (requiere API key), polygon
DATA_PROVIDER=yfinance
DATA_CACHE_TTL_HOURS=4
POLYGON_API_KEY=

# ── Deploy en la nube (Render/Fly.io/Railway) ───────────────────────────
PORT=8000
HOST=0.0.0.0
RENDER_EXTERNAL_URL=
CLOUD_APP_URL=

# ── Configuración de Riesgo (opcional, defaults conservadores) ──────────
# MAX_DAILY_LOSS_PCT=-0.02
# MAX_SECTOR_EXPOSURE_PCT=0.25
# MAX_TOTAL_EXPOSURE_PCT=0.65
# INITIAL_CAPITAL=100000.0
# LEVERAGE_ENABLED=true
# MIN_LEVERAGE=2.0
# MAX_LEVERAGE=3.0

# ── Model Gate (opcional, defaults) ────────────────────────────────────
# GATE_MIN_ACCURACY=0.55
# GATE_MIN_PRECISION=0.50
# GATE_MIN_EDGE=0.03

# ── Champion/Challenger (opcional, defaults) ────────────────────────────
# CC_PROMO_MARGIN=0.02
# CC_MAX_AGE_DAYS=14
