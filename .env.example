# ── Alpaca Broker (obligatorio) ────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# ── Telegram (opcional, para alertas críticas del bot) ─────────────────
# Crea un bot con @BotFather y obtén tu chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord (opcional, alternativa a Telegram) ─────────────────────────
DISCORD_WEBHOOK_URL=

